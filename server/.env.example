# 复制本文件为 .env 并填入真实值（.env 已被 gitignore，不要提交）
# PostgreSQL 连接：本地库名建议 onebill
DATABASE_URL=postgresql+psycopg2://postgres:你的数据库密码@localhost:5432/onebill

# 微信小程序后台 → 开发 → 开发设置 里拿
WECHAT_APPID=你的小程序AppID
WECHAT_SECRET=你的小程序AppSecret

# JWT 签名密钥，务必换成长随机串（如 openssl rand -hex 32）
JWT_SECRET=please-change-me-to-a-long-random-string

# CORS：逗号分隔；本地可 *；上线改为实际来源（小程序通常不走浏览器 CORS，但管理端/H5 需要）
# CORS_ORIGINS=*
# CORS_ORIGINS=https://your-domain.example,http://localhost:8000
# 生产建议关闭 Swagger：EXPOSE_API_DOCS=false
# EXPOSE_API_DOCS=false

# 反馈截图落盘目录（相对 server/，已在 .gitignore）
# UPLOAD_DIR=uploads

# LLM（当前默认 SiliconFlow；也可换成其他 OpenAI 兼容接口）
LLM_API_KEY=你的LLM密钥
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Embedding（向量检索）
SILICONFLOW_API_KEY=你的SiliconFlow密钥
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# 可选：拍照记账 OCR 视觉模型（默认 DeepSeek-OCR；可改回 Paddle）
# OCR_MODEL=deepseek-ai/DeepSeek-OCR
# OCR_MODEL=PaddlePaddle/PaddleOCR-VL-1.5
# OCR_TIMEOUT_SECONDS=90

# 可选：上游超时（秒），避免挂死 worker
# LLM_TIMEOUT_SECONDS=30
# EMBEDDING_TIMEOUT_SECONDS=20

# 可选：旧 DeepSeek 配置（若代码仍读取）
# DEEPSEEK_API_KEY=你的DeepSeek密钥
