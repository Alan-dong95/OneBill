/* tab 页可靠写法：绝对铺满「状态栏～tabBar」之间的可视区（本页自定义导航） */
page {
  height: 100%;
  background: #f3f7f4;
  overflow: hidden;
}

.page {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  background: #f3f7f4;
  overflow: hidden;
  box-sizing: border-box;
}

/* 自定义导航：色值对齐 app.json window，右侧放「新对话」 */
.custom-nav {
  flex-shrink: 0;
  background: #1a2e1f;
  box-sizing: border-box;
}

.custom-nav-inner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.custom-nav-title {
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1;
}

.custom-nav-action {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  padding: 8rpx 4rpx;
  color: #fff;
  font-size: 28rpx;
  line-height: 1;
  opacity: 0.92;
}

.custom-nav-action-hover {
  opacity: 0.7;
}

.chat-list {
  flex: 1;
  height: 0;
  width: 100%;
  box-sizing: border-box;
}

.chat-inner {
  padding: 28rpx 28rpx 24rpx;
  box-sizing: border-box;
}

.msg-row {
  display: flex;
  margin-bottom: 28rpx;
}

.msg-row.is-user {
  justify-content: flex-end;
}

.msg-row.is-ai {
  justify-content: flex-start;
}

.msg-col {
  position: relative;
  display: flex;
  flex-direction: column;
  max-width: 78%;
}

.msg-row.is-user .msg-col {
  align-items: flex-end;
}

.msg-row.is-ai .msg-col {
  align-items: flex-start;
}

.msg-time {
  margin-bottom: 8rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  color: #9aab9e;
  line-height: 1;
}

.bubble {
  position: relative;
  max-width: 100%;
  padding: 22rpx 26rpx;
  box-sizing: border-box;
}

.bubble-user {
  background: #2ecc71;
  border-radius: 24rpx 8rpx 24rpx 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(46, 204, 113, 0.18);
}

.bubble-ai {
  background: #fff;
  border-radius: 8rpx 24rpx 24rpx 24rpx;
  border: 2rpx solid #d8eeda;
  overflow: visible;
}

/* 加载态：紧凑小气泡 + 发芽 emoji 轻跳 */
.bubble.is-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 22rpx;
  max-width: 96rpx;
  min-width: 80rpx;
  overflow: hidden;
  background: #eef8f1;
  border-color: #c8e6d0;
}

.loading-sprout {
  font-size: 44rpx;
  line-height: 1;
  display: inline-block;
  animation: sprout-bounce 1.1s ease-in-out infinite;
}

@keyframes sprout-bounce {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8rpx);
  }
}

/* 长按复制浮层：贴气泡上方 */
.copy-tip {
  position: absolute;
  left: 50%;
  bottom: calc(100% + 12rpx);
  transform: translateX(-50%);
  z-index: 5;
  padding: 10rpx 28rpx;
  border-radius: 12rpx;
  background: #1a2e1f;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
  white-space: nowrap;
  box-shadow: 0 6rpx 16rpx rgba(26, 46, 31, 0.22);
}

.copy-tip::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 100%;
  margin-left: -8rpx;
  border: 8rpx solid transparent;
  border-top-color: #1a2e1f;
}

.bubble-user .bubble-text {
  color: #fff;
}

.bubble-ai .bubble-text {
  color: #1a2e1f;
}

.bubble-text {
  font-size: 28rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
}

.chat-end {
  height: 8rpx;
}

.composer {
  flex-shrink: 0;
  z-index: 10;
  background: #fff;
  border-top: 1rpx solid #e8f0ea;
  padding: 12rpx 24rpx 20rpx;
  box-sizing: border-box;
}

/* 推荐问题横滑 */
.suggest-scroll {
  width: 100%;
  margin-bottom: 12rpx;
  white-space: nowrap;
}

.suggest-row {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  padding: 0 2rpx;
}

.suggest-chip {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  border-radius: 28rpx;
  background: #eef8f1;
  border: 2rpx solid #d8eeda;
  color: #1a2e1f;
  font-size: 24rpx;
  line-height: 1.3;
  white-space: nowrap;
}

.suggest-chip-hover {
  background: #d8f0e0;
}

.suggest-chip.is-disabled {
  opacity: 0.45;
}

.composer-bar {
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
}

/* 左侧小麦克风 */
.composer-mic {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #eef8f1;
  border: 2rpx solid #d8eeda;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: background 0.08s linear, border-color 0.08s linear;
}

.composer-mic.is-active {
  background: #2ecc71;
  border-color: #27ae60;
}

.composer-mic.is-disabled {
  opacity: 0.45;
  pointer-events: none;
}

.mic-glyph {
  position: relative;
  width: 28rpx;
  height: 36rpx;
  pointer-events: none;
}

.mic-capsule {
  position: absolute;
  left: 50%;
  top: 0;
  width: 14rpx;
  height: 22rpx;
  margin-left: -7rpx;
  border-radius: 7rpx;
  background: #2d8c5c;
}

.composer-mic.is-active .mic-capsule,
.composer-mic.is-active .mic-stem,
.composer-mic.is-active .mic-base {
  background: #fff;
}

.mic-arc {
  position: absolute;
  left: 50%;
  top: 6rpx;
  width: 24rpx;
  height: 18rpx;
  margin-left: -12rpx;
  border: 3rpx solid #2d8c5c;
  border-top: none;
  border-radius: 0 0 14rpx 14rpx;
  box-sizing: border-box;
}

.composer-mic.is-active .mic-arc {
  border-color: #fff;
}

.mic-stem {
  position: absolute;
  left: 50%;
  bottom: 4rpx;
  width: 3rpx;
  height: 8rpx;
  margin-left: -1.5rpx;
  background: #2d8c5c;
}

.mic-base {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 14rpx;
  height: 3rpx;
  margin-left: -7rpx;
  border-radius: 2rpx;
  background: #2d8c5c;
}

.composer-input {
  flex: 1;
  min-width: 0;
  min-height: 72rpx;
  max-height: 180rpx;
  padding: 18rpx 24rpx;
  box-sizing: border-box;
  background: #f3f7f4;
  border-radius: 28rpx;
  font-size: 28rpx;
  line-height: 1.45;
  color: #1a2e1f;
}

.composer-placeholder {
  color: #9aab9e;
  font-size: 26rpx;
}

.composer-send {
  flex-shrink: 0;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 30rpx;
  border-radius: 36rpx;
  background: #2ecc71;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
}

.composer-send-hover {
  opacity: 0.88;
}

.composer-send.is-disabled {
  opacity: 0.45;
}
