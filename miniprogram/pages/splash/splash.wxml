<view class="splash">
  <image class="splash-mascot" src="{{mascot}}" mode="aspectFit" />
  <view class="splash-brand">韭菜保护本</view>
  <view class="splash-sub" wx:if="{{!loginFailed && !showAgreement}}">记账护身，少做一棵韭菜</view>
  <view class="splash-sub" wx:elif="{{loginFailed}}">登录没成功，协会门打不开</view>
  <view class="splash-sub" wx:else>先过协会门槛，再进门记账</view>

  <button
    wx:if="{{loginFailed}}"
    class="btn-primary splash-retry"
    hover-class="btn-hover"
    bindtap="onRetryLogin"
  >再试一次</button>
  <view wx:elif="{{entering}}" class="splash-hint">正在进门…</view>
</view>

<!-- 首次打开：微信登录前必须同意协议 -->
<view class="modal-mask" wx:if="{{showAgreement}}" catchtouchmove="noop">
  <view class="modal-panel" catchtap="noop">
    <view class="modal-title">欢迎使用韭菜保护本</view>
    <view class="modal-desc">
      我们将严格保护你的隐私，请阅读并同意
      <text class="modal-link" catchtap="goUserAgreement">《用户服务协议》</text>
      和
      <text class="modal-link" catchtap="goPrivacyAgreement">《隐私政策》</text>
      后使用
    </view>
    <view class="modal-actions">
      <button class="btn-refuse modal-btn" hover-class="btn-refuse-hover" bindtap="onRefuse">拒绝</button>
      <button class="btn-primary modal-btn" hover-class="btn-hover" bindtap="onAgree">同意并继续</button>
    </view>
  </view>
</view>
