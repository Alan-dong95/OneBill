.page {
  min-height: 100vh;
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f3f7f4;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
}

.plain {
  font-size: 28rpx;
  line-height: 1.7;
  color: #5a6b5e;
}
