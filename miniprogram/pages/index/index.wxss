.page {
  padding-bottom: 48rpx;
}

.hero {
  padding: 28rpx 32rpx 0;
}

.hero-top {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.mascot {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
  background: #e8f6ec;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.brand {
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  color: #1a2e1f;
  line-height: 1.3;
}

.tip {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #5a6b5e;
  line-height: 1.4;
}

/* 今日+本月合并深色主卡片 */
.month-card {
  background: linear-gradient(145deg, #1a2e1f 0%, #2a4a32 100%);
  border-radius: 28rpx;
  padding: 28rpx 32rpx 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(26, 46, 31, 0.18);
}

.month-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.month-label {
  flex: 1;
  min-width: 0;
  color: rgba(255, 255, 255, 0.55);
  font-size: 24rpx;
  line-height: 1.4;
}

.month-today {
  flex-shrink: 0;
  color: rgba(255, 255, 255, 0.55);
  font-size: 24rpx;
  font-weight: 500;
}

.month-amount {
  margin-top: 16rpx;
  color: #2ecc71;
  font-size: 68rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.month-amount.skeleton {
  color: rgba(255, 255, 255, 0.25);
  font-size: 56rpx;
}

.month-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
  line-height: 1.4;
}

/* 预算提醒：贴在深色卡下方，醒目但不抢主卡 */
.budget-alert {
  margin-top: 16rpx;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
  text-align: center;
}

.budget-alert-warn {
  background: rgba(243, 156, 18, 0.14);
  color: #c87f0a;
  border: 2rpx solid rgba(243, 156, 18, 0.35);
}

.budget-alert-danger {
  background: rgba(231, 76, 60, 0.12);
  color: #c0392b;
  border: 2rpx solid rgba(231, 76, 60, 0.3);
}

/* 菜菜复盘入口 */
.report-entry {
  margin: 20rpx 32rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 2rpx solid #d8eeda;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.report-entry-hover {
  background: #f7faf8;
}

.report-entry-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: #f3f7f4;
}

.report-entry-copy {
  flex: 1;
  min-width: 0;
}

.report-entry-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a2e1f;
  line-height: 1.35;
}

.report-entry-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #27ae60;
  font-weight: 600;
}

.report-entry-arrow {
  font-size: 44rpx;
  color: #2ecc71;
  font-weight: 300;
  line-height: 1;
  padding-bottom: 4rpx;
}

.actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx 4rpx;
  box-sizing: border-box;
}

.action-btn {
  flex: 1;
  width: 0;
  min-width: 0;
}

.section {
  margin-top: 28rpx;
  padding: 0 32rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  min-height: 40rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a2e1f;
}

.section-link {
  font-size: 24rpx;
  color: #27ae60;
  font-weight: 600;
  padding: 8rpx 0 8rpx 16rpx;
}

.state {
  text-align: center;
  color: #9aab9e;
  padding: 80rpx 0;
  font-size: 26rpx;
}

.empty-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 40rpx 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-mascot {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 8rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a2e1f;
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9aab9e;
}

.empty-btn {
  margin-top: 32rpx;
}

.recent-list {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.recent-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid #eef3ef;
}

.recent-item:last-child {
  border-bottom: none;
}

.item-hover {
  background: #f7faf8;
}

.recent-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #eef8f1;
  font-size: 34rpx;
  line-height: 72rpx;
  text-align: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.recent-mid {
  flex: 1;
  min-width: 0;
}

.recent-cat {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a2e1f;
}

.recent-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9aab9e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-right {
  text-align: right;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.recent-amount {
  font-size: 30rpx;
  font-weight: 700;
  color: #e74c3c;
}

.recent-time {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #b5c4b8;
}
