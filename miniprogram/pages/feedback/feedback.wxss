.page {
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  min-height: 100%;
}

.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx 32rpx;
  margin-bottom: 32rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1a2e1f;
  line-height: 1.3;
}

.hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9aab9e;
  line-height: 1.4;
}

.textarea {
  margin-top: 28rpx;
  width: 100%;
  min-height: 280rpx;
  box-sizing: border-box;
  padding: 24rpx;
  background: #f3f7f4;
  border-radius: 20rpx;
  border: 2rpx solid #d8e3db;
  font-size: 28rpx;
  color: #1a2e1f;
  line-height: 1.6;
}

.ph {
  color: #9aab9e;
}

.label {
  margin-top: 32rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #5a6b5e;
}

.image-row {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 168rpx;
  height: 168rpx;
}

.thumb {
  width: 168rpx;
  height: 168rpx;
  border-radius: 16rpx;
  background: #f3f7f4;
}

.image-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #1a2e1f;
  color: #fff;
  font-size: 28rpx;
  line-height: 36rpx;
  text-align: center;
}

.image-add {
  width: 168rpx;
  height: 168rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  border: 2rpx dashed #d8e3db;
  background: #f3f7f4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.image-add-hover {
  background: #e8f6ec;
  border-color: #27ae60;
}

.image-add-plus {
  font-size: 48rpx;
  color: #27ae60;
  line-height: 1;
  font-weight: 300;
}

.image-add-text {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #9aab9e;
  font-weight: 600;
}

.contact-input {
  margin-top: 16rpx;
  height: 80rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #f3f7f4;
  border: 2rpx solid #d8e3db;
  font-size: 28rpx;
  color: #1a2e1f;
}

.submit-btn {
  margin-top: 8rpx;
}
