.page {
  padding: 28rpx 32rpx 48rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.month-hero {
  background: linear-gradient(145deg, #1a2e1f 0%, #2a4a32 100%);
  border-radius: 28rpx;
  padding: 32rpx 32rpx 36rpx;
  box-shadow: 0 12rpx 32rpx rgba(26, 46, 31, 0.18);
}

.month-label {
  color: rgba(255, 255, 255, 0.65);
  font-size: 24rpx;
}

.month-count {
  color: rgba(255, 255, 255, 0.45);
}

.month-amount {
  margin-top: 12rpx;
  color: #2ecc71;
  font-size: 68rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.month-amount.skeleton {
  color: rgba(255, 255, 255, 0.25);
  font-size: 56rpx;
}

.month-amount-error {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 26rpx;
  text-decoration: underline;
}

.loading-block {
  margin-top: 28rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx 52rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.loading-img {
  width: 280rpx;
  height: 280rpx;
  border-radius: 20rpx;
  background: #f3f7f4;
}

.loading-title {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1a2e1f;
}

.loading-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9aab9e;
}

.report-card {
  margin-top: 28rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 32rpx;
}

.report-card-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.report-card-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  background: #f3f7f4;
}

.report-card-label {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: #1a2e1f;
}

.report-card-body {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #1a2e1f;
  line-height: 1.75;
  word-break: break-word;
}

.report-plain {
  font-size: 28rpx;
  color: #1a2e1f;
  line-height: 1.75;
  white-space: pre-wrap;
  word-break: break-word;
}

.footer {
  margin-top: 24rpx;
}
