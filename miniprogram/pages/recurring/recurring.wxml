<view class="page">
  <view class="hint" wx:if="{{!loading && !empty}}">左滑可删除 · 到期会自动记一笔</view>

  <view class="loading" wx:if="{{loading}}">加载中…</view>

  <view class="empty" wx:elif="{{empty}}">
    <view class="empty-title">还没有周期账单</view>
    <view class="empty-desc">在「记一笔 → 手动记」打开重复记账，会员费房租水电就交给协会盯着</view>
  </view>

  <view class="list-card" wx:else>
    <movable-area
      class="swipe-area {{index > 0 ? 'with-divider' : ''}}"
      wx:for="{{list}}"
      wx:key="id"
      style="width: {{listWidth}}px; height: {{rowHeight}}px;"
    >
      <movable-view
        class="swipe-view"
        style="width: {{mainWidth + actionWidth}}px; height: {{rowHeight}}px;"
        direction="horizontal"
        inertia="{{false}}"
        out-of-bounds="{{true}}"
        damping="40"
        animation="{{true}}"
        x="{{item.x}}"
        data-id="{{item.id}}"
        data-index="{{index}}"
        bindchange="onSwipeChange"
        bindtouchstart="onSwipeStart"
        bindtouchend="onSwipeEnd"
        bindtouchcancel="onSwipeEnd"
      >
        <view class="swipe-main" style="width: {{mainWidth}}px;">
          <view class="row-icon">{{item.icon}}</view>
          <view class="row-body">
            <view class="row-top">
              <text class="row-cat">{{item.category}}</text>
              <text class="row-amount">-¥{{item.amountText}}</text>
            </view>
            <view class="row-desc">{{item.description}}</view>
            <view class="row-meta">
              <text class="row-period">{{item.periodLabel}}</text>
              <text class="row-dot">·</text>
              <text class="row-next">下次 {{item.nextDateText}}</text>
            </view>
          </view>
        </view>
        <view class="swipe-actions" style="width: {{actionWidth}}px;">
          <view
            class="swipe-delete"
            catchtap="onDeleteTap"
            data-id="{{item.id}}"
          >删除</view>
        </view>
      </movable-view>
    </movable-area>
  </view>
</view>
