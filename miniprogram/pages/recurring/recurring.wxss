.page {
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  min-height: 100%;
}

.hint {
  margin-bottom: 16rpx;
  font-size: 22rpx;
  color: #9aab9e;
  font-weight: 600;
}

.loading,
.empty {
  margin-top: 120rpx;
  text-align: center;
}

.loading {
  font-size: 28rpx;
  color: #9aab9e;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a2e1f;
}

.empty-desc {
  margin: 16rpx 48rpx 0;
  font-size: 24rpx;
  color: #9aab9e;
  line-height: 1.55;
}

.list-card {
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
}

.swipe-area {
  position: relative;
  overflow: hidden;
  background: #fff;
}

.swipe-area.with-divider {
  border-top: 1rpx solid #eef3ef;
}

.swipe-view {
  display: flex;
  align-items: stretch;
}

.swipe-main {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding: 0 28rpx;
  height: 100%;
  background: #fff;
  flex-shrink: 0;
}

.swipe-actions {
  display: flex;
  align-items: stretch;
  height: 100%;
  flex-shrink: 0;
}

.swipe-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  flex: 1;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  background: #e74c3c;
}

.row-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #f3f7f4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.row-body {
  flex: 1;
  min-width: 0;
}

.row-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 16rpx;
}

.row-cat {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a2e1f;
}

.row-amount {
  font-size: 30rpx;
  font-weight: 800;
  color: #1a2e1f;
  flex-shrink: 0;
}

.row-desc {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #5a6b5e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-meta {
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #9aab9e;
  font-weight: 600;
}

.row-dot {
  margin: 0 8rpx;
}

.row-next {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
