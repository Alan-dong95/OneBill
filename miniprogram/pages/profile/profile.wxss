.page {
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
  min-height: 100%;
}

.user-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  background: linear-gradient(145deg, #1a2e1f 0%, #2a4a32 100%);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(26, 46, 31, 0.18);
  margin-bottom: 24rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  background: #e8f6ec;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-title {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.3;
}

.user-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.48);
  line-height: 1.4;
}

/* 横排三数字，轻量不是大卡片 */
.stats-row {
  display: flex;
  align-items: stretch;
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx 8rpx;
  margin-bottom: 24rpx;
}

.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  padding: 4rpx 8rpx;
}

.stat-value {
  font-size: 30rpx;
  font-weight: 800;
  color: #1a2e1f;
  line-height: 1.2;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #9aab9e;
  font-weight: 600;
}

.stat-divider {
  width: 1rpx;
  align-self: stretch;
  margin: 8rpx 0;
  background: #d8e3db;
}

.badge-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.badge-label {
  font-size: 24rpx;
  color: #9aab9e;
  font-weight: 600;
}

.badge-pill {
  display: inline-block;
  margin-top: 16rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #e8f6ec;
  color: #27ae60;
  font-size: 28rpx;
  font-weight: 700;
}

.badge-hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #5a6b5e;
  line-height: 1.4;
}

.menu-card {
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 48rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #d8e3db;
}

.menu-item-last {
  border-bottom: none;
}

.menu-hover {
  background: #f3f7f4;
}

.menu-text {
  font-size: 28rpx;
  color: #1a2e1f;
  font-weight: 600;
  flex: 1;
}

.menu-tag {
  margin-right: 12rpx;
  font-size: 22rpx;
  color: #5a6b5e;
  font-weight: 600;
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-danger {
  color: #e74c3c;
  flex: 1;
}

.menu-arrow {
  font-size: 36rpx;
  color: #9aab9e;
  line-height: 1;
}

.version {
  text-align: center;
  font-size: 22rpx;
  color: #9aab9e;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

/* 昵称弹窗 */
.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(26, 46, 31, 0.36);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.modal-panel {
  width: 100%;
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 32rpx 32rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a2e1f;
  text-align: center;
}

.modal-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #5a6b5e;
  text-align: center;
}

.modal-input {
  margin-top: 28rpx;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #f3f7f4;
  border: 2rpx solid #d8e3db;
  font-size: 28rpx;
  color: #1a2e1f;
}

.modal-placeholder {
  color: #9aab9e;
}

.modal-actions {
  margin-top: 28rpx;
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
}
