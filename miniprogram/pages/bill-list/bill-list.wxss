.page {
  padding: 8rpx 32rpx 48rpx;
}

/* ========== 月份筛选 + 搜索 ========== */
.month-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0 8rpx;
}

.month-picker {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 2rpx solid #d8eeda;
  font-size: 24rpx;
  color: #2a4a32;
  font-weight: 600;
  flex-shrink: 0;
}

.month-picker-arrow {
  font-size: 20rpx;
  color: #9aab9e;
}

.month-clear {
  font-size: 24rpx;
  color: #27ae60;
  font-weight: 600;
  padding: 8rpx 8rpx;
  flex-shrink: 0;
}

.month-clear-off {
  color: #c5d0c8;
  pointer-events: none;
}

.search-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx 8rpx 20rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 2rpx solid #d8eeda;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 48rpx;
  font-size: 24rpx;
  color: #1a2e1f;
  line-height: 48rpx;
}

.search-placeholder {
  color: #b5c4b8;
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #e8f5ec;
  color: #27ae60;
  font-size: 28rpx;
  line-height: 36rpx;
  text-align: center;
  flex-shrink: 0;
}

.search-clear-off {
  opacity: 0;
  pointer-events: none;
}

/* ========== 统计页入口 ========== */
.stats-entry {
  margin: 12rpx 0 20rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #e8f8ef 0%, #f3faf5 100%);
  border: 2rpx solid #d8eeda;
}

.stats-entry-hover {
  background: #dff5e8;
}

.stats-entry-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a2e1f;
  letter-spacing: 0.5rpx;
}

/* ========== 统计图表卡片 ========== */
.charts {
  margin-bottom: 8rpx;
}

.chart-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 20rpx 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.chart-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a2e1f;
  padding: 0 8rpx 8rpx;
}

.chart-body {
  width: 100%;
  height: 360rpx;
  /* 防止 canvas 溢出 */
  overflow: hidden;
}

.chart-body ec-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.chart-empty {
  height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #b5c4b8;
}

.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 4rpx 20rpx;
}

.toolbar-text {
  font-size: 26rpx;
  color: #5a6b5e;
  font-weight: 600;
}

.toolbar-hint {
  font-size: 22rpx;
  color: #b5c4b8;
}

.state {
  text-align: center;
  color: #9aab9e;
  padding: 160rpx 0;
  font-size: 26rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 100rpx 40rpx 0;
}

.empty-mascot {
  width: 220rpx;
  height: 220rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a2e1f;
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9aab9e;
}

.empty-btn {
  margin-top: 40rpx;
}

.group {
  margin-bottom: 28rpx;
}

.group-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 8rpx 8rpx 16rpx;
}

.group-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1a2e1f;
}

.group-total {
  font-size: 24rpx;
  color: #9aab9e;
}

.bill-list {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.swipe-area {
  position: relative;
  overflow: hidden;
  background: #fff;
}

.swipe-area.with-divider {
  border-top: 1rpx solid #eef3ef;
}

.swipe-view {
  display: flex;
  align-items: stretch;
}

.swipe-main {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding: 0 28rpx;
  height: 100%;
  background: #fff;
  flex-shrink: 0;
}

.swipe-actions {
  display: flex;
  align-items: stretch;
  height: 100%;
  flex-shrink: 0;
}

.swipe-edit,
.swipe-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  flex: 1;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.swipe-edit {
  background: #27ae60;
}

.swipe-delete {
  background: #e74c3c;
}

.bill-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #eef8f1;
  font-size: 34rpx;
  line-height: 72rpx;
  text-align: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.bill-left {
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}

.bill-category {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a2e1f;
  line-height: 1.3;
}

.bill-meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  min-width: 0;
  font-size: 22rpx;
  color: #9aab9e;
  line-height: 1.3;
}

.bill-desc {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 70%;
}

.bill-dot {
  margin: 0 8rpx;
  color: #c5d0c8;
  flex-shrink: 0;
}

.bill-time {
  flex-shrink: 0;
  color: #b5c4b8;
}

.bill-amount {
  flex-shrink: 0;
  font-size: 32rpx;
  font-weight: 700;
  color: #e74c3c;
  letter-spacing: -0.5rpx;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.list-footer {
  text-align: center;
  padding: 24rpx 0 8rpx;
  font-size: 24rpx;
  color: #b5c4b8;
}
